def islegitinch(findindex,passport):
    if int(passport[findindex+4:findindex+6]) <= 76 and int(passport[findindex+4:findindex+6]) >= 59:
        return True
    else:
        return False

def islegitcm(findindex,passport):
    if int(passport[findindex+4:findindex+7]) <= 193 and int(passport[findindex+4:findindex+7]) >= 150:
        return True
    else:
        return False

