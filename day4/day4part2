def isvalideyecolour(findindex,passport):
    if passport[findindex+4:findindex+7] in ['amb', 'blu', 'brn', 'gry', 'grn', 'hzl', 'oth']:
        return True
    else:
        return False

def isvalidhaircolour(findindex,passport):
    print(passport[findindex+4:findindex+11])
    if re.fullmatch(r'#[a-f0-9]{6}',passport[findindex+4:findindex+11]):
        return True
    else:
        return False
