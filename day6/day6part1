with open('day6/input.txt', 'r') as file:
    result=0
    groupanswer=[]
    helper=''
    i=0
    alphabet=['a', 'b', 'c', 'd', 'e', 'f', 'g', 'h', 'i', 'j', 'k', 'l', 'm', 'n', 'o', 'p', 'q', 'r', 's', 't', 'u', 'v', 'w', 'x', 'y', 'z']
    for line in file:
        if line == '\n':
            groupanswer.append(helper)
            print('group answer',i+1,' is: ', groupanswer[i])
            i+=1
            helper=''   
        else:
            helper+= line
                #print(repr(line))
for answer in groupanswer:
    for letter in alphabet:
        if letter in answer:
            result+=1
        else:
            print(letter, ' not in', answer)
    print('the result is:',result)